[project]
name = "{{ project_name }}"
version = "0.1.0"
description = "{{ project_summary }}"
authors = [
    {name = "{{ author_name }}", email ="{{ author_email }}"},
]
readme = "README.md"
license-files = ["LICENSE.md"]

requires-python = ">={{ python_versions[0] }}, ~={{ python_versions[-1] }}"
dependencies = []


[project.urls]
homepage = "https://github.com/{{ github_account }}/{{project_name}}"
source = "https://github.com/{{ github_account }}/{{project_name}}"
changelog = "https://github.com/{{ github_account }}/{{project_name}}/blob/main/CHANGELOG.md"

{% if include_demo %}
[project.optional-dependencies]
demo = [ "roadshow>=0.1.2" ]
{% endif %}

{% if include_demo %}
[project.scripts]
{{ project_name }}-demo = "{{ module_name }}_demo.main:main"
{% endif %}

[dependency-groups]
dev = [
    "debugpy>=1.8",
    "ipython>=9.18",
    "mkdocstrings[python]>=0.29",
    "pyclean>=3.7",
    "pytest>=9.2",
    "pytest-bdd>=9.0",
    "pytest-cov>=7.1",
    "pytest-mock>=3.17",
    "pytest-pretty>=1.3",
    "pytest-random-order>=1.2",
    "ruff>=0.17.4",
    "ty>=0.0.100",
    "typos>=1.52",
    "zensical>=0.1.1 "
]


[tool.uv]
package = true


[tool.pytest.ini_options]
addopts = [
    "--random-order",
    "--cov=src/{{ module_name }}",
    "--cov-report=term-missing",
    "--cov-fail-under=100",
    "--cov-report=xml:.coverage.xml",
    "--junitxml=.junit.xml",
    "--override-ini=junit_family=legacy",
]
testpaths = ["tests"]
python_files = ["test_*.py", "*_steps.py"]
markers = [
    "integration: Integration tests that exercise the real package with no mocking",
    "unit: Fast unit tests with all external dependencies mocked",
]


[tool.ruff]
line-length = 120
src = ["src/{{ module_name }}", "tests"{% if include_demo %}, "src/{{ module_name }}_demo"{% endif %}{% if include_examples %}, "examples"{% endif %}]


[tool.ruff.format]
docstring-code-format = true


[tool.typos.default]
extend-ignore-identifiers-re = []


[build-system]
requires = ["uv-build>=0.13.7,<0.14"]
build-backend = "uv_build"
