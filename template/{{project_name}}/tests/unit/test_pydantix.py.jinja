from datetime import timedelta
from typing import Annotated

import pendulum
import pytest
from {{ module_name }}.pydantix import DurationAnnotation
from pydantic import BaseModel, ValidationError


class DummyModel(BaseModel):
    span: Annotated[pendulum.Duration, DurationAnnotation]


def test_validate__duration_instance():
    span = pendulum.duration(seconds=1)
    instance = DummyModel(span=span)
    assert instance.span == span


def test_validate__python_timedelta_instance():
    span = pendulum.duration(seconds=1)
    instance = DummyModel(span=timedelta(seconds=1))
    assert instance.span == span


def test_validate__string():
    span = pendulum.duration(seconds=1)
    instance = DummyModel(span="PT1S")
    assert instance.span == span


def test_validate__failure():
    with pytest.raises(ValidationError, match="Couldn't validate"):
        DummyModel(span=13)
